{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Собрать проект",
            "type": "shell",
            "windows": { "command": ".\\build.bat" },
            "linux": { "command": "make" },
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Запустить тесты",
            "type": "shell",
            "windows": { "command": ".\\bin\\tests.exe" },
            "linux": { "command": "./bin/tests" },
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Собрать проект",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Удалить собранные файлы",
            "type": "shell",
            "windows": { "command": ".\\build.bat clean" },
            "linux": { "command": "make clean" },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
